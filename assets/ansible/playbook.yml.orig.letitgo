---
- name: Debian post-install setup for Alienware X51 R3
  hosts: localhost
  connection: local
  become: true
  gather_facts: true

  vars_files:
    - group_vars/all.yml

  tasks:
    # ------------------------------------------------------------------
    # --- Basic system hardening / convenience
    # ------------------------------------------------------------------
    # - hostname
    # - network
    # - firewall
    # - user accounts
    # - additional packages
    #
    - name: Allow passwordless sudo for console user
      copy:
        dest: /etc/sudoers.d/__USER_GAME__
        content: "{{ username }} ALL=(ALL:ALL) NOPASSWD: ALL\n"
        mode: "0440"
        validate: visudo -cf %s

    - name: Enable and start tuned
      systemd:
        name: tuned
        enabled: true
        state: started

    - name: Set tuned profile to latency-performance
      command: tuned-adm profile latency-performance
      changed_when: true

    # ------------------------------------------------------------------
    # --- Setup additional (shared) system
    # ------------------------------------------------------------------
    # - Install DRIVER_STACK packages
    # - Install X or wayland (depending on chosen DRIVER_STACK)
    # - Install hardware/video acceleration packages (for chosen DRIVER_STACK)
    # - Configure/Optimize system hardware/video acceleration (for chosen DRIVER_STACK)
    # - Configure/optimize system for chosen DRIVER_STACK
    # - Configure/optimize system for chosen SESSION_TYPE
    # - Optional DVD/Bluray support
    #
    - name: Install proprietary NVIDIA stack
      when: driver_stack == "nvidia"
      apt:
        name:
          - nvidia-driver
          - xserver-xorg-video-nvidia
        state: present
        update_cache: true

    - name: Set GRUB cmdline for NVIDIA
      when: driver_stack == "nvidia"
      copy:
        src: files/grub.console
        dest: /etc/default/grub
        mode: "0644"

    - name: Set GRUB cmdline for Nouveau / open drivers
      when: driver_stack != "nvidia"
      copy:
        src: files/grub.desktop
        dest: /etc/default/grub
        mode: "0644"

    - name: Update GRUB
      command: update-grub
      changed_when: true

    - name: Install Blu-ray support packages
      when: bluray_support | bool
      apt:
        name:
          - vlc
          - libaacs0
          - libbdplus0
        state: present
        update_cache: true

    - name: Create AACS directory
      when: bluray_support | bool
      file:
        path: /etc/aacs
        state: directory
        mode: "0755"

    # ------------------------------------------------------------------
    # --- Setup Desktop environment
    # ------------------------------------------------------------------
    # - install DE
    # - Install Display Manager
    #
    - name: Enable Cockpit socket
      systemd:
        name: cockpit.socket
        enabled: true
        state: started

    # ------------------------------------------------------------------
    # --- Cockpit custom port (optional)
    # ------------------------------------------------------------------
    - name: Override Cockpit listen port
      when: cockpit_port | string != "9090"
      block:
        - name: Create cockpit.socket drop-in directory
          file:
            path: /etc/systemd/system/cockpit.socket.d
            state: directory
            mode: "0755"

        - name: Write cockpit port override
          copy:
            dest: /etc/systemd/system/cockpit.socket.d/override.conf
            content: |
              [Socket]
              ListenStream=
              ListenStream={{ cockpit_port }}
            mode: "0644"

        - name: Reload systemd after cockpit override
          systemd:
            daemon_reload: true

    # ------------------------------------------------------------------
    # --- Native iptables firewall (optional)
    # ------------------------------------------------------------------
    - name: Deploy iptables firewall
      when: firewall_enabled | bool
      block:
        - name: Install firewall script
          copy:
            src: files/iptables-firewall.sh
            dest: /usr/local/bin/iptables-firewall.sh
            mode: "0755"

        - name: Install firewall systemd unit
          copy:
            src: files/iptables-firewall.service
            dest: /etc/systemd/system/iptables-firewall.service
            mode: "0644"

        - name: Enable firewall service
          systemd:
            name: iptables-firewall.service
            enabled: true
            daemon_reload: true

    # ------------------------------------------------------------------
    # --- Graphics / GRUB command line
    # ------------------------------------------------------------------
    - name: Install proprietary NVIDIA stack
      when: driver_stack == "nvidia"
      apt:
        name:
          - nvidia-driver
          - xserver-xorg-video-nvidia
        state: present
        update_cache: true

    - name: Set GRUB cmdline for NVIDIA
      when: driver_stack == "nvidia"
      copy:
        src: files/grub.console
        dest: /etc/default/grub
        mode: "0644"

    - name: Set GRUB cmdline for Nouveau / open drivers
      when: driver_stack != "nvidia"
      copy:
        src: files/grub.desktop
        dest: /etc/default/grub
        mode: "0644"

    - name: Update GRUB
      command: update-grub
      changed_when: true

    # ------------------------------------------------------------------
    # --- Optional packages
    # ------------------------------------------------------------------
    - name: Install Blu-ray support packages
      when: bluray_support | bool
      apt:
        name:
          - vlc
          - libaacs0
          - libbdplus0
        state: present
        update_cache: true

    - name: Create AACS directory
      when: bluray_support | bool
      file:
        path: /etc/aacs
        state: directory
        mode: "0755"

    - name: Install Firefox
      when: browser == "firefox"
      apt:
        name: firefox
        state: present
        update_cache: true

    # ------------------------------------------------------------------
    # --- Native Steam / console mode
    # ------------------------------------------------------------------
    # - Setup 32bit library support
    # - Install 32bit library packages (for chosen DRIVER_STACK)
    # - Install steam (native steam client)
    # - Install/Configure steam (native client) support packages
    #   - steam-devices (udev rules)
    # - Install steam desktop session
    # - Configure/optimize system for chosen DRIVER_STACK
    # - Configure/optimize system for steam gaming/performance
    #   - Configure kernel
    #     - IO
    #   - Configure DRIVER_STACK environment
    #   - Configure power handling matrix
    #     - Handle DE power states
    #     - Handle systemd power states
    #     - Handle power button states
    #   - Configure steam vm heap stack
    #   - Configure steam vulkan shader cache
    #   - Configure passwordless entry
    #     - login
    #     - lockscreen
    #   - Configure first time setup
    #
    - name: Enable i386 architecture for Steam
      when: native_steam | bool
      command: dpkg --add-architecture i386
      changed_when: true

    - name: Install Steam + SDDM
      when: native_steam | bool
      apt:
        name:
          - steam-installer
          - sddm
        state: present
        update_cache: true

    - name: Create xsessions directory
      when: native_steam | bool
      file:
        path: /usr/share/xsessions
        state: directory
        mode: "0755"

    - name: Install Steam Big Picture session desktop file
      when: native_steam | bool
      copy:
        src: files/steam-session.desktop
        dest: /usr/share/xsessions/steam-session.desktop
        mode: "0644"

    - name: Install Steam session launcher script
      when: native_steam | bool
      copy:
        src: files/steam-session.sh
        dest: /usr/local/bin/steam-session.sh
        mode: "0755"

    - name: Install steamos-update helper
      when: native_steam | bool
      copy:
        src: files/steamos-update
        dest: /usr/bin/steamos-update
        mode: "0755"

    # ------------------------------------------------------------------
    # --- Wallpapers / extra assets (wip)
    # ------------------------------------------------------------------
    - name: Install wallpapers
      copy:
        src: "{{ item }}"
        dest: /usr/share/wallpapers/Alienware/
        mode: "0644"
      with_fileglob:
        - backgrounds/* # Adjust path depending on how to copy assets into the target
