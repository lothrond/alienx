# WIFI_SSID is a string:
#	- Any thing i want goes here.
#
# WIFI_PASS is a string:
#	- Any thing i want goes here.
#
WIFI_SSID ?= MyHomeNetwork
WIFI_PASS ?= SuperSecretPassword

