# Debian 13 Trixie Preseed for Alienware X51 R3
d-i debian-installer/locale string __LOCAL_LANG__
d-i keyboard-configuration/xkb-keymap select __LOCAL_KMAP__
d-i time/zone string __LOCAL_TZ__

# Repositories
# (Enable contrib, non-free, and non-free-firmware for complete hardware support)
d-i apt-setup/non-free-firmware boolean __NON_FREE__
d-i apt-setup/non-free boolean __NON_FREE__
d-i apt-setup/contrib boolean __NON_FREE__

# Network Configuration
d-i netcfg/choose_interface select auto
d-i netcfg/wireless_wep string 
d-i netcfg/get_hostname string __LOCAL_HOST__
d-i netcfg/get_domain string local

# Admin (root) Account Setup
#d-i passwd/root-password password __ROOT_PASSWORD__
#d-i passwd/root-password-again password __ROOT_PASSWORD__
d-i passwd/user-fullname string __USER_ADMIN_FULL__
d-i passwd/username string __USER_ADMIN__
d-i passwd/user-password password __ROOT_PASSWORD__
d-i passwd/user-password-again password __ROOT_PASSWORD__

# SteamOS Gaming Account Setup
d-i passwd/user-fullname string __USER_GAME_FULL__
d-i passwd/username string __USER_GAME__
d-i passwd/user-password password __USER_PASSWORD__
d-i passwd/user-password-again password __USER_PASSWORD__

# Disk Partitioning
d-i partman-auto/disk string __LOCAL_DEV__
d-i partman-auto/method string regular
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Base Packages
# (Including Firewall, Cockpit, firmware, performance tuners, and lighting tools)
tasksel tasksel/first multiselect standard
d-i pkgsel/include string __PKGS__

# Grub Bootloader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string default

# Setup Scripting via late_command (Flattened into a single line for Debconf compliance)
d-i preseed/late_command string in-target /bin/bash -c "echo /"__USER_GAME__ ALL=(ALL:ALL) NOPASSWD: ALL/" > /etc/sudoers.d/__USER_GAME__; systemctl enable tuned; tuned-adm profile latency-performance; systemctl enable --now cockpit.socket; if [ '__FIREWALL_ENABLED__' = 'true' ]; then mkdir -p /usr/local/bin /etc/systemd/system; printf '#!/bin/bash\niptables -F\niptables -X\niptables -P INPUT DROP\niptables -P FORWARD DROP\niptables -P OUTPUT ACCEPT\niptables -A INPUT -i lo -j ACCEPT\niptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT\niptables -A INPUT -p tcp --dport 22 -j ACCEPT\niptables -A INPUT -p tcp --dport __COCKPIT_PORT__ -j ACCEPT\n' > /usr/local/bin/iptables-firewall.sh; chmod +x /usr/local/bin/iptables-firewall.sh; printf '[Unit]\nDescription=Native iptables Firewall Service\nAfter=network.target\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/iptables-firewall.sh\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/iptables-firewall.service; systemctl daemon-reload; systemctl enable iptables-firewall.service; fi; if [ '__COCKPIT_PORT__' != '9090' ]; then mkdir -p /etc/systemd/system/cockpit.socket.d; printf '[Socket]\nListenStream=\nListenStream=__COCKPIT_PORT__\n' > /etc/systemd/system/cockpit.socket.d/override.conf; systemctl daemon-reload; fi; if [ '__DRIVER_STACK__' = 'nvidia' ]; then apt-get install -y nvidia-driver xserver-xorg-video-nvidia; sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 nvidia-drm.modeset=1 mitigations=off\"/' /etc/default/grub; update-grub; else sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 mitigations=off\"/' /etc/default/grub; update-grub; fi; if [ '__BLURAY_SUPPORT__' = 'true' ]; then apt-get install -y vlc libaacs0 libbdplus0; mkdir -p /etc/aacs; fi; if [ '__BROWSER__' = 'firefox' ]; then apt-get install -y firefox; fi; if [ '__NATIVE_STEAM__' = 'true' ]; then dpkg --add-architecture i386; apt-get update; apt-get install -y steam-installer sddm; mkdir -p /usr/share/xsessions; printf '[Desktop Entry]\nName=Steam Big Picture Session\nComment=Standalone native Steam session for gaming\nExec=/usr/local/bin/steam-session.sh\nType=Application\n' > /usr/share/xsessions/steam-session.desktop; printf '#!/bin/bash\nSTEAM_ARGS=\"-tenfoot -steamos -enableremoteplay\"\nxset s off -dpms\nxset s noblank\nexec gamemoderun /usr/games/steam \$STEAM_ARGS\n' > /usr/local/bin/steam-session.sh; printf '#!/bin/bash\nsudo apt-get update\nsudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y\nif command -v flatpak >/dev/null 2>&1; then sudo flatpak update -y; fi\nexit 0\n' > /usr/bin/steamos-update; chmod +x /usr/local/bin/steam-session.sh /usr/bin/steamos-update; fi"

d-i finish-install/reboot_in_progress note