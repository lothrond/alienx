#_preseed_V1

# Localization & System Settings
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us
d-i time/zone string America/New_York
d-i clock-setup/utc boolean true

# Network & Hostname
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string debian-maxwell
d-i netcfg/get_domain string local

# Mirror Settings
d-i mirror/country string manual
d-i mirror/http/hostname string debian.map.fastly.net
d-i mirror/http/directory string /debian
d-i mirror/suite string trixie
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true

# Multiarch Injection (Required for 32-bit gaming libs)
@@MULTIARCH_SETUP@@

# Base Account Setup (Root explicitly disabled; Admin created)
d-i passwd/root-login boolean false
d-i passwd/user-fullname string admin
d-i passwd/username string admin
d-i passwd/user-password-crypted password $6$rounds=100000$REPLACEME
d-i passwd/user-default-groups string audio cdrom video sudo

# Target Disk
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman/mount_style select uuid

# Partitioning (Injected via Makefile)
d-i partman-auto/expert_recipe string custom-recipe :: @@PARTITION_RECIPE@@
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Kernel & Packages (Injected via Makefile)
d-i base-installer/kernel/image string linux-image-amd64
tasksel tasksel/first multiselect standard
d-i pkgsel/include string @@PACKAGES@@
d-i pkgsel/upgrade select full-upgrade

# Bootloader
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# Late Command Automation (Injected via Makefile)
d-i preseed/late_command string @@LATE_COMMAND@@